{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node", "mocha"],
    "outDir": "dist-ts"
  },
  "include": ["hardhat.config.ts", "scripts/**/*.ts", "test/**/*.ts", "src/**/*.ts"],
  "exclude": ["node_modules", "web"]
}
